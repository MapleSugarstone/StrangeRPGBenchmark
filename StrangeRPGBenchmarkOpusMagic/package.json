{
  "name": "rote",
  "version": "0.1.0",
  "private": true,
  "description": "A tile-based role-playing game where you write your own spells in a small language.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/build.mjs --tools && node dist-tools/test.js",
    "sim": "node scripts/build.mjs --tools && node dist-tools/sim.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
